# 依赖与构建产物
node_modules/
dist/

# 包管理器用 pnpm（见 package.json 的 packageManager）。
# 挡掉 npm 的 lockfile：谁本地跑一次 npm install 就会把它生成出来，
# 两份 lockfile 并存会互相打架。
package-lock.json
yarn.lock

# 本地配置（含服务端密钥），别进版本库；模板见 .env.example
.env.local

# 编辑器与工具目录
.claude/
.idea/
.vscode/
.ref/

# 本地运行数据（如果以后开启 JSON 持久化）
data/

# 日志
*.log

# 操作系统杂项
.DS_Store
Thumbs.db
desktop.ini
